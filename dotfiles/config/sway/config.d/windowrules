for_window [class="^.*"] inhibit_idle fullscreen

# Правила окон
set $opacity 0.85
#set $opacity 1

for_window [class="jetbrains-(.*)" title="splash"] floating enable
for_window [app_id="python3"] floating enable
for_window [title="Choose ONE of the audio conference options"] floating enable
for_window [title="Открыть файл"] floating enable
for_window [title="Открыть папку"] floating enable
for_window [title="Firefox — индикатор доступа"] floating enable
for_window [app_id="terminal-floating"] floating enable, opacity $opacity
for_window [app_id="^launcher$"] floating enable, resize set 640 440, move position center, sticky enable
for_window [app_id="Alacritty"] opacity $opacity
for_window [app_id="foot"] opacity $opacity
for_window [title="Bild-im-Bild"] floating enable, sticky enable
for_window [title="Индикатор раскладки — K:04"] floating enable, sticky enable
for_window [title="Картинка в картинке"] floating enable, sticky enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable

#for_window [app_id="kitty"] opacity $opacity
#for_window [app_id="neovide"] opacity $opacity

no_focus [title="^uq-markdown$"]

gaps inner 5
corner_radius 10
blur enable
titlebar_separator disable

hide_edge_borders smart

default_border pixel 3
default_floating_border none
titlebar_padding 1
title_align center

#layer_effects wofi {
#    blur enable;
#}


font pango:Mononoki Nerd Font 12

set $bg  #32302f
set $fg  #d4be98
set $br  #e78a4e
set $red #ea6962

# class                 border  backgr. text    indicator child_border
client.focused          $br     $br     $bg     $bg       $br
client.focused_inactive $bg     $bg     $fg     $bg       $bg
client.unfocused        $bg     $bg     $fg     $bg       $bg
client.urgent           $red    $red    $bg     $red      $red


